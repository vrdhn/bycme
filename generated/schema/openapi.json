  "components": {
    "schemas": {
      "Building": {
        "type": "object",
        "required": [
          "id",
          "cityId",
          "name",
          "buildingType",
          "createdAt"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "cityId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "buildingType": {
            "$ref": "#/components/schemas/BuildingType"
          },
          "createdAt": {
            "type": "string"
          },
          "cityName": {
            "type": "string"
          }
        }
      },
      "BuildingType": {
        "type": "string",
        "enum": [
          "Private",
          "Public"
        ]
      },
      "City": {
        "type": "object",
        "required": [
          "id",
          "name",
          "state",
          "createdAt"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "createdAt": {
            "type": "string"
          }
        }
      },
      "CreateBuildingRequest": {
        "type": "object",
        "required": [
          "cityId",
          "name",
          "buildingType"
        ],
        "properties": {
          "cityId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "buildingType": {
            "$ref": "#/components/schemas/BuildingType"
          }
        }
      },
      "CreateCityRequest": {
        "type": "object",
        "required": [
          "name",
          "state"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "state": {
            "type": "string"
          }
        }
      },
      "CreateManagerInvitationRequest": {
        "type": "object",
        "properties": {
          "durationHours": {
            "type": "integer",
            "format": "int32"
          },
          "isPreapproved": {
            "type": "boolean"
          }
        }
      },
      "CreateParkingRequest": {
        "type": "object",
        "required": [
          "buildingId",
          "name",
          "capacity"
        ],
        "properties": {
          "buildingId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "capacity": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "HealthStatus": {
        "type": "object",
        "required": [
          "status",
          "timestamp",
          "environment"
        ],
        "properties": {
          "status": {
            "type": "string"
          },
          "timestamp": {
            "type": "string"
          },
          "environment": {
            "type": "string"
          }
        }
      },
      "InvitationStatus": {
        "type": "string",
        "enum": [
          "active",
          "used",
          "revoked"
        ]
      },
      "LoginRequest": {
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "LoginResponse": {
        "type": "object",
        "required": [
          "token",
          "user"
        ],
        "properties": {
          "token": {
            "type": "string"
          },
          "user": {
            "$ref": "#/components/schemas/Person"
          }
        }
      },
      "ManagerInvitation": {
        "type": "object",
        "required": [
          "id",
          "token",
          "parkingId",
          "role",
          "createdBy",
          "status",
          "isPreapproved",
          "expiresAt",
          "inviteUrl",
          "whatsappMessage",
          "createdAt"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "token": {
            "type": "string"
          },
          "parkingId": {
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/PersonRole"
          },
          "createdBy": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/InvitationStatus"
          },
          "isPreapproved": {
            "type": "boolean"
          },
          "expiresAt": {
            "type": "string"
          },
          "inviteUrl": {
            "type": "string"
          },
          "whatsappMessage": {
            "type": "string"
          },
          "parkingName": {
            "type": "string"
          },
          "cityName": {
            "type": "string"
          },
          "createdByName": {
            "type": "string"
          },
          "createdAt": {
            "type": "string"
          }
        }
      },
      "Parking": {
        "type": "object",
        "required": [
          "id",
          "buildingId",
          "name",
          "capacity",
          "createdAt"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "buildingId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "capacity": {
            "type": "integer",
            "format": "int32"
          },
          "createdAt": {
            "type": "string"
          },
          "buildingName": {
            "type": "string"
          },
          "cityName": {
            "type": "string"
          }
        }
      },
      "Person": {
        "type": "object",
        "required": [
          "id",
          "email",
          "name",
          "roles",
          "createdAt"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "roles": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PersonRole"
            }
          },
          "createdAt": {
            "type": "string"
          }
        }
      },
      "PersonRole": {
        "type": "string",
        "enum": [
          "Admin",
          "Manager",
          "Rider"
        ]
      },
      "UpdateBuildingRequest": {
        "type": "object",
        "properties": {
          "cityId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "buildingType": {
            "$ref": "#/components/schemas/BuildingType"
          }
        }
      },
      "UpdateCityRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "state": {
            "type": "string"
          }
        }
      },
      "UpdateParkingRequest": {
        "type": "object",
        "properties": {
          "buildingId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "capacity": {
            "type": "integer",
            "format": "int32"
          }
        }
      }
    }
  },
  "servers": [
    {
      "url": "https://bycme-staging.bycme-backend.workers.dev",
