#!/usr/bin/env python3
"""Developer workflow driver for bycme repository."""

import argparse
import getpass
import hashlib
import json
import os
import platform
import shutil
import subprocess
import sys
import tarfile
import urllib.request
from pathlib import Path

# Tool version specifications
NODE_VERSION = "v22.23.3"
CACHE_DIR_DEFAULT = Path.home() / ".cache" / "bycme-repo"
CACHE_DIR = Path(os.environ.get("BYCME_CACHE_DIR", CACHE_DIR_DEFAULT)).resolve()
BIN_DIR = CACHE_DIR / "bin"
TOOLS_DIR = CACHE_DIR / "tools"
REPO_ROOT = Path(__file__).resolve().parent
CONFIG_PATH = REPO_ROOT / "config.json"


def prepend_bin_to_path() -> None:
    """Prepend cache bin directory and export NODE_PATH."""
    bin_str = str(BIN_DIR)
    current_path = os.environ.get("PATH", "")
    paths = current_path.split(os.pathsep) if current_path else []
    if bin_str not in paths:
        os.environ["PATH"] = f"{bin_str}{os.pathsep}{current_path}"

    node_modules_path = str(CACHE_DIR / "lib" / "node_modules")
    current_node_path = os.environ.get("NODE_PATH", "")
    if node_modules_path not in current_node_path:
        os.environ["NODE_PATH"] = f"{node_modules_path}{os.pathsep}{current_node_path}" if current_node_path else node_modules_path


def ensure_directories() -> None:
    """Create cache directory structure."""
    CACHE_DIR.mkdir(parents=True, exist_ok=True)
    BIN_DIR.mkdir(parents=True, exist_ok=True)
    TOOLS_DIR.mkdir(parents=True, exist_ok=True)


def get_platform_node_target() -> str:
    """Resolve OS and architecture to Node binary archive name."""
    system = platform.system().lower()
    machine = platform.machine().lower()

    if system == "linux":
        os_tag = "linux"
    elif system == "darwin":
        os_tag = "darwin"
    else:
        raise RuntimeError(f"Unsupported operating system: {system}")

    if machine in ("x86_64", "amd64"):
        arch_tag = "x64"
    elif machine in ("aarch64", "arm64"):
        arch_tag = "arm64"
    else:
        raise RuntimeError(f"Unsupported architecture: {machine}")

    return f"node-{NODE_VERSION}-{os_tag}-{arch_tag}"


def download_file(url: str, dest_path: Path) -> None:
    """Download remote file via HTTP request."""
    sys.stdout.write(f"Downloading {url} ...\n")
    sys.stdout.flush()
    with urllib.request.urlopen(url) as response, open(dest_path, "wb") as out_file:
        shutil.copyfileobj(response, out_file)


def extract_archive(archive_path: Path, extract_dir: Path) -> None:
    """Extract tar archive into destination directory."""
    sys.stdout.write(f"Extracting {archive_path.name} ...\n")
    sys.stdout.flush()
    with tarfile.open(archive_path, "r:*") as tar:
        tar.extractall(path=extract_dir)


def symlink_binary(source: Path, target: Path) -> None:
    """Create or update symlink to executable."""
    if target.is_symlink() or target.exists():
        target.unlink()
    target.symlink_to(source)


def link_node_binaries(node_root: Path) -> None:
    """Link node, npm, npx executables into bin directory."""
    node_bin = node_root / "bin"
    for name in ("node", "npm", "npx"):
        src = node_bin / name
        if src.exists():
            symlink_binary(src, BIN_DIR / name)


def parse_semver_major(version_str: str) -> int:
    """Extract semver major version as integer."""
    clean = version_str.strip().lstrip("v")
    major = clean.split(".")[0]
    return int(major) if major.isdigit() else 0


def get_installed_node_major() -> int:
    """Check installed node major version in bin directory."""
    node_bin = BIN_DIR / "node"
    if not node_bin.exists():
        return 0
    try:
        proc = subprocess.run(
            [str(node_bin), "--version"],
            capture_output=True,
            text=True,
            check=False,
            timeout=5,
        )
        if proc.returncode == 0:
            return parse_semver_major(proc.stdout)
    except Exception:
        pass
    return 0


def install_node() -> None:
    """Download and install portable Node.js binaries."""
    node_target = get_platform_node_target()
    node_dest = TOOLS_DIR / node_target
    target_major = parse_semver_major(NODE_VERSION)

    if get_installed_node_major() >= target_major:
        sys.stdout.write(f"Node.js ({NODE_VERSION}+) already active.\n")
        return

    archive_name = f"{node_target}.tar.xz"
    archive_url = f"https://nodejs.org/dist/{NODE_VERSION}/{archive_name}"
    archive_path = CACHE_DIR / archive_name

    download_file(archive_url, archive_path)
    extract_archive(archive_path, TOOLS_DIR)
    archive_path.unlink(missing_ok=True)
    link_node_binaries(node_dest)


def install_npm_packages() -> None:
    """Install wrangler, typespec compiler and emitters into cache prefix."""
    npm_path = BIN_DIR / "npm"
    packages = [
        "wrangler",
        "@typespec/compiler",
        "@typespec/http",
        "@typespec/rest",
        "@typespec/openapi3",
    ]

    sys.stdout.write("Installing npm toolchain packages ...\n")
    sys.stdout.flush()
    env = {**os.environ, "PATH": f"{BIN_DIR}:{os.environ.get('PATH', '')}"}
    cmd = [
        str(npm_path),
        "install",
        "-g",
        "--prefix",
        str(CACHE_DIR),
        *packages,
    ]
    subprocess.run(cmd, env=env, check=True)


def check_tool(name: str, version_args: list[str]) -> tuple[bool, str]:
    """Check binary availability and version."""
    bin_path = shutil.which(name)
    if not bin_path:
        return False, "Not found"
    try:
        proc = subprocess.run(
            [bin_path, *version_args],
            capture_output=True,
            text=True,
            check=False,
            timeout=5,
        )
        lines = [line.strip() for line in (proc.stdout or proc.stderr).splitlines() if line.strip()]
        version = lines[0] if lines else "Installed"
        return True, f"{version} ({bin_path})"
    except Exception as exc:
        return False, f"Error: {exc}"


def load_config() -> dict:
    """Load configuration dictionary from repository config.json."""
    if not CONFIG_PATH.exists():
        return {}
    try:
        with open(CONFIG_PATH, "r", encoding="utf-8") as file:
            return json.load(file)
    except Exception:
        return {}


def get_environment_config(config: dict, env_name: str) -> dict:
    """Retrieve environment configuration dictionary by name."""
    envs = config.get("environments", {})
    if isinstance(envs, dict) and env_name in envs:
        val = envs[env_name]
        if isinstance(val, dict):
            return val
    return {}


def get_staging_project(config: dict) -> str:
    """Extract staging project identifier from configuration."""
    return get_env_project(config, "staging")


def get_staging_db(config: dict) -> str:
    """Extract staging D1 database name from configuration."""
    return get_env_db(config, "staging")


def get_env_project(config: dict, env_name: str) -> str:
    """Extract project identifier for given environment."""
    env_cfg = get_environment_config(config, env_name)
    if "project" in env_cfg:
        return str(env_cfg["project"])
    if env_name == "staging" and "staging_project" in config:
        return str(config["staging_project"])
    return f"bycme-{env_name}"


def get_env_db(config: dict, env_name: str) -> str:
    """Extract D1 database name for given environment."""
    env_cfg = get_environment_config(config, env_name)
    if "d1_database" in env_cfg:
        return str(env_cfg["d1_database"])
    return f"bycme-{env_name}-db"


def fetch_cloudflare_identity() -> dict | None:
    """Query Cloudflare identity data via wrangler in JSON format."""
    wrangler_path = shutil.which("wrangler")
    if not wrangler_path:
        return None
    try:
        env = {**os.environ, "CI": "true"}
        proc = subprocess.run(
            [wrangler_path, "whoami", "--json"],
            capture_output=True,
            text=True,
            check=False,
            timeout=30,
            env=env,
        )
        if proc.returncode == 0 and proc.stdout:
            return json.loads(proc.stdout)
    except Exception:
        pass
    return None


def check_cloudflare_access(identity: dict | None) -> tuple[bool, str]:
    """Verify general Cloudflare authentication status."""
    wrangler_path = shutil.which("wrangler")
    if not wrangler_path:
        return False, "wrangler not found; run './btool install'"
    if identity and identity.get("loggedIn"):
        email = identity.get("email", "unknown")
        auth_type = identity.get("authType", "token")
        return True, f"{email} ({auth_type})"
    return False, "Not authenticated. Run './btool login' or set CLOUDFLARE_API_TOKEN"


def check_project_access(identity: dict | None, project_name: str) -> tuple[bool, str]:
    """Verify access to specified project or account name."""
    if not project_name:
        return False, "Missing staging project in config.json"
    if not identity or not identity.get("loggedIn"):
        return False, "Requires Cloudflare login; run './btool login'"

    accounts = identity.get("accounts", [])
    for acc in accounts:
        if acc.get("name") == project_name or acc.get("id") == project_name:
            acc_id = acc.get("id", "unknown")
            return True, f"Accessible under account '{project_name}' (ID: {acc_id})"

    return False, f"Project '{project_name}' not found in Cloudflare accounts"


def ensure_typespec_modules() -> None:
    """Link cache node_modules into typespec directory for compiler resolution."""
    typespec_modules = REPO_ROOT / "typespec" / "node_modules"
    cache_modules = CACHE_DIR / "lib" / "node_modules"
    if not typespec_modules.exists() and cache_modules.exists():
        typespec_modules.symlink_to(cache_modules)


def run_check_command() -> int:
    """Execute environment, Cloudflare, and project access checks."""
    print("=== Tool Availability Check ===")
    tools = [
        ("node", ["--version"]),
        ("npm", ["--version"]),
        ("wrangler", ["--version"]),
        ("tsp", ["--version"]),
    ]

    all_passed = True
    for name, args in tools:
        ok, details = check_tool(name, args)
        status = "OK" if ok else "FAIL"
        print(f"[{status}] {name:10}: {details}")
        if not ok:
            all_passed = False

    config = load_config()
    staging_project = get_staging_project(config)

    print("\n=== Cloudflare Access Check ===")
    identity = fetch_cloudflare_identity()
    cf_ok, cf_details = check_cloudflare_access(identity)
    cf_status = "OK" if cf_ok else "FAIL"
    print(f"[{cf_status}] Cloudflare : {cf_details}")
    if not cf_ok:
        all_passed = False

    print("\n=== Project Access Check ===")
    proj_ok, proj_details = check_project_access(identity, staging_project)
    proj_status = "OK" if proj_ok else "FAIL"
    target_label = staging_project if staging_project else "(none)"
    print(f"[{proj_status}] Staging ({target_label}): {proj_details}")
    if not proj_ok:
        all_passed = False

    return 0 if all_passed else 1


def run_install_command() -> int:
    """Execute installation of toolchain into cache directory."""
    print(f"Installing toolchain into: {CACHE_DIR}")
    ensure_directories()
    prepend_bin_to_path()
    install_node()
    install_npm_packages()
    print("\nInstallation complete.")
    print(f"Executables located in: {BIN_DIR}")
    return 0


def run_login_command() -> int:
    """Execute interactive wrangler login."""
    wrangler_path = shutil.which("wrangler")
    if not wrangler_path:
        sys.stderr.write("wrangler not found; run './btool install' first.\n")
        return 1
    proc = subprocess.run([wrangler_path, "login"])
    return proc.returncode


def run_codegen_command() -> int:
    """Compile TypeSpec definitions into OpenAPI schema and shared types."""
    print("=== [Codegen] Compiling TypeSpec API Definitions ===")
    ensure_typespec_modules()
    tsp_path = shutil.which("tsp")
    if not tsp_path:
        print("[FAIL] tsp not found; run './btool install'")
        return 1

    proc = subprocess.run(
        [tsp_path, "compile", "typespec", "--pretty=false"],
        cwd=REPO_ROOT,
        check=False,
    )
    if proc.returncode != 0:
        print("[FAIL] TypeSpec compilation failed.")
        return proc.returncode

    schema_file = REPO_ROOT / "generated" / "schema" / "openapi.json"
    if schema_file.exists():
        print(f"[OK] OpenAPI schema generated at: {schema_file}")
    else:
        print("[FAIL] Schema output not found.")
        return 1
    return 0


def check_generated_drift() -> tuple[bool, str]:
    """Check git status and diff on generated directory."""
    proc = subprocess.run(
        ["git", "status", "--porcelain", "generated"],
        cwd=REPO_ROOT,
        capture_output=True,
        text=True,
        check=False,
    )
    if proc.returncode != 0:
        return False, f"Git status command failed with exit code {proc.returncode}"
    status_output = proc.stdout.strip()
    if status_output:
        diff_proc = subprocess.run(
            ["git", "diff", "generated"],
            cwd=REPO_ROOT,
            capture_output=True,
            text=True,
            check=False,
        )
        diff_output = diff_proc.stdout.strip()
        details = diff_output if diff_output else status_output
        return False, details
    return True, ""


def run_verify_command() -> int:
    """Verify generated artifacts match TypeSpec contract without drift."""
    print("=== [Verify] Checking Generated Artifacts Integrity ===")
    rc = run_codegen_command()
    if rc != 0:
        print("[FAIL] Codegen step failed during verification.")
        return rc

    clean, diff_text = check_generated_drift()
    if not clean:
        print("[FAIL] Generated files drift detected:")
        print(diff_text)
        print("\nGenerated files are out of sync with TypeSpec definition or modified manually.")
        print("Run './btool codegen' locally and commit the resulting generated files.")
        return 1

    print("[OK] Generated files match contract definitions.")
    return 0


def run_build_command() -> int:
    """Build backend Worker bundle and frontend React SPA."""
    print("\n=== [Build] Building Frontend and Backend Artifacts ===")
    npm_path = shutil.which("npm")
    if not npm_path:
        print("[FAIL] npm not found; run './btool install'")
        return 1

    frontend_dir = REPO_ROOT / "frontend"
    if not (frontend_dir / "node_modules").exists():
        print("Installing frontend npm dependencies ...")
        proc_install = subprocess.run([npm_path, "install"], cwd=frontend_dir, check=False)
        if proc_install.returncode != 0:
            print("[FAIL] Frontend npm install failed.")
            return proc_install.returncode

    print("Building frontend React SPA with Vite ...")
    proc_build = subprocess.run([npm_path, "run", "build"], cwd=frontend_dir, check=False)
    if proc_build.returncode != 0:
        print("[FAIL] Frontend build failed.")
        return proc_build.returncode

    dist_index = frontend_dir / "dist" / "index.html"
    if not dist_index.exists():
        print("[FAIL] Frontend dist bundle missing index.html")
        return 1

    print("[OK] Frontend bundle built successfully in frontend/dist.")
    return 0


def run_migrate_command(env_name: str = "staging", is_dev: bool = False) -> int:
    """Apply pending SQL migrations to Cloudflare D1 database."""
    mode_label = "local" if is_dev else env_name
    print(f"\n=== [Migrate] Applying D1 Database Migrations ({mode_label}) ===")
    wrangler_path = shutil.which("wrangler")
    if not wrangler_path:
        print("[FAIL] wrangler not found; run './btool install'")
        return 1

    config = load_config()
    db_name = get_env_db(config, env_name)
    backend_dir = REPO_ROOT / "backend"

    print(f"Applying pending migrations from sqlsource/migrations/ to '{db_name}' ...")
    env = {**os.environ, "CI": "true"}
    mode_flag = "--local" if is_dev else "--remote"
    cmd = [
        wrangler_path,
        "d1",
        "migrations",
        "apply",
        db_name,
        mode_flag,
    ]
    proc = subprocess.run(cmd, cwd=backend_dir, env=env, check=False)
    if proc.returncode != 0:
        print(f"[FAIL] Migrations failed for database '{db_name}'.")
        return proc.returncode

    print(f"[OK] D1 migrations applied successfully to '{db_name}'.")
    return 0


def run_dbdrop_command(env_name: str = "staging", auto_confirm: bool = False) -> int:
    """Drop all tables, views, and migration state in staging D1 database."""
    if env_name != "staging":
        print(f"[FAIL] dbdrop is strictly prohibited for environment '{env_name}'. It is only available for 'staging'.")
        return 1

    wrangler_path = shutil.which("wrangler")
    if not wrangler_path:
        print("[FAIL] wrangler not found; run './btool install'")
        return 1

    config = load_config()
    db_name = get_env_db(config, "staging")
    backend_dir = REPO_ROOT / "backend"

    print("\n=== [dbdrop] Drop Staging D1 Database Tables ===")
    print(f"Target Database: {db_name} (staging)")

    if not auto_confirm:
        try:
            prompt = f"Are you sure you want to drop all tables in '{db_name}'? [y/N]: "
            sys.stdout.write(prompt)
            sys.stdout.flush()
            ans = sys.stdin.readline().strip().lower()
            if ans not in ("y", "yes"):
                print("[ABORTED] Database drop cancelled by user.")
                return 0
        except KeyboardInterrupt:
            print("\n[ABORTED] Database drop cancelled.")
            return 1

    env = {**os.environ, "CI": "true"}

    query_cmd = [
        wrangler_path,
        "d1",
        "execute",
        db_name,
        "--remote",
        "--command=SELECT name, type FROM sqlite_schema WHERE type IN ('table', 'view') AND name NOT LIKE 'sqlite_%' AND name NOT LIKE '_cf_%';",
        "--json",
    ]
    proc = subprocess.run(query_cmd, cwd=backend_dir, env=env, capture_output=True, text=True, check=False)
    if proc.returncode != 0:
        print(f"[FAIL] Could not query database schema: {proc.stderr or proc.stdout}")
        return proc.returncode

    try:
        data = json.loads(proc.stdout)
        results = data[0].get("results", []) if data and isinstance(data, list) else []
    except Exception as exc:
        print(f"[FAIL] Failed to parse schema query result: {exc}")
        return 1

    if not results:
        print(f"[OK] Database '{db_name}' has no user tables to drop.")
        return 0

    print(f"Dropping {len(results)} object(s) from '{db_name}' ...")
    drop_queue = list(results)
    max_passes = len(drop_queue) + 1
    current_pass = 0

    while drop_queue and current_pass < max_passes:
        current_pass += 1
        remaining: list[dict] = []
        for item in drop_queue:
            t_name = item.get("name")
            t_type = item.get("type", "table").upper()
            if not t_name:
                continue
            drop_cmd = [
                wrangler_path,
                "d1",
                "execute",
                db_name,
                "--remote",
                f"--command=DROP {t_type} IF EXISTS \"{t_name}\";",
            ]
            res = subprocess.run(drop_cmd, cwd=backend_dir, env=env, capture_output=True, text=True, check=False)
            if res.returncode != 0:
                remaining.append(item)
            else:
                print(f"  [DELETED] {t_type.lower()}: {t_name}")

        if len(remaining) == len(drop_queue):
            print(f"[FAIL] Unable to resolve foreign key constraints while dropping: {[x.get('name') for x in remaining]}")
            return 1
        drop_queue = remaining

    if drop_queue:
        print(f"[FAIL] Could not drop all objects in '{db_name}'. Remaining: {[x.get('name') for x in drop_queue]}")
        return 1

    print(f"[OK] Staging database '{db_name}' tables and migration state dropped successfully.")
    return 0


def run_dbseed_command(env_name: str = "staging", is_dev: bool = False) -> int:
    """Populate D1 database with seed SQL files from sqlsource/seeds/."""
    wrangler_path = shutil.which("wrangler")
    if not wrangler_path:
        print("[FAIL] wrangler not found; run './btool install'")
        return 1

    config = load_config()
    db_name = get_env_db(config, env_name)
    backend_dir = REPO_ROOT / "backend"
    seeds_dir = REPO_ROOT / "sqlsource" / "seeds"

    mode_label = "local" if is_dev else env_name
    print(f"\n=== [dbseed] Seeding D1 Database ({mode_label}) ===")
    print(f"Target Database: {db_name}")

    print("Ensuring latest schema migrations are applied ...")
    mig_rc = run_migrate_command(env_name, is_dev=is_dev)
    if mig_rc != 0:
        print("[FAIL] Migration failed before seeding.")
        return mig_rc

    if not seeds_dir.exists():
        print(f"[FAIL] Seeds directory not found at {seeds_dir}")
        return 1

    seed_files = sorted(seeds_dir.glob("seed-*.sql"))
    if not seed_files:
        master_seed = seeds_dir / "seed.sql"
        if master_seed.exists():
            seed_files = [master_seed]
        else:
            print("[WARN] No seed SQL files found in sqlsource/seeds/")
            return 0

    mode_flag = "--local" if is_dev else "--remote"
    env = {**os.environ, "CI": "true"}

    for sf in seed_files:
        print(f"Applying seed: {sf.name} ...")
        cmd = [
            wrangler_path,
            "d1",
            "execute",
            db_name,
            mode_flag,
            f"--file={sf.resolve()}",
        ]
        proc = subprocess.run(cmd, cwd=backend_dir, env=env, check=False)
        if proc.returncode != 0:
            print(f"[FAIL] Seed file '{sf.name}' execution failed.")
            return proc.returncode

    print(f"[OK] Database '{db_name}' seeded successfully ({len(seed_files)} seed file(s) applied).")
    return 0


def hash_password(password: str, salt_hex: str | None = None) -> tuple[str, str]:
    """Generate PBKDF2-HMAC-SHA256 salt and hash for password."""
    if not salt_hex:
        salt_hex = os.urandom(32).hex()
    salt_bytes = bytes.fromhex(salt_hex)
    key = hashlib.pbkdf2_hmac("sha256", password.encode("utf-8"), salt_bytes, 100000)
    return key.hex(), salt_hex


def run_passwd_command(
    email: str,
    password: str | None = None,
    env_name: str = "staging",
    is_dev: bool = False,
) -> int:
    """Update password for given user email in D1 database."""
    wrangler_path = shutil.which("wrangler")
    if not wrangler_path:
        print("[FAIL] wrangler not found; run './btool install'")
        return 1

    if not email or not email.strip():
        print("[FAIL] User email required.")
        return 1

    clean_email = email.strip()

    if not password:
        try:
            pwd1 = getpass.getpass(f"Enter new password for '{clean_email}': ")
            if not pwd1:
                print("[FAIL] Password cannot be empty.")
                return 1
            pwd2 = getpass.getpass("Confirm new password: ")
            if pwd1 != pwd2:
                print("[FAIL] Passwords do not match.")
                return 1
            password = pwd1
        except (KeyboardInterrupt, EOFError):
            print("\n[CANCELLED] Password update aborted.")
            return 1

    pwd_hash, pwd_salt = hash_password(password)

    config = load_config()
    db_name = get_env_db(config, env_name)
    backend_dir = REPO_ROOT / "backend"
    mode_flag = "--local" if is_dev else "--remote"
    env = {**os.environ, "CI": "true"}

    escaped_email = clean_email.replace("'", "''")
    sql = (
        f"UPDATE persons SET password_hash = '{pwd_hash}', password_salt = '{pwd_salt}' "
        f"WHERE LOWER(email) = LOWER('{escaped_email}');"
    )

    mode_label = "local" if is_dev else env_name
    print(f"Updating password for '{clean_email}' in '{db_name}' ({mode_label}) ...")
    cmd = [
        wrangler_path,
        "d1",
        "execute",
        db_name,
        mode_flag,
        f"--command={sql}",
    ]
    proc = subprocess.run(cmd, cwd=backend_dir, env=env, check=False)
    if proc.returncode != 0:
        print(f"[FAIL] Password update failed for '{clean_email}'.")
        return proc.returncode

    print(f"[OK] Password updated successfully for '{clean_email}'.")
    return 0


def run_publish_command(env_name: str = "staging") -> int:
    """Deploy backend Worker and frontend Pages to Cloudflare."""
    print(f"\n=== [Publish] Deploying Backend Worker and Frontend Pages ({env_name}) ===")
    wrangler_path = shutil.which("wrangler")
    if not wrangler_path:
        print("[FAIL] wrangler not found; run './btool install'")
        return 1

    config = load_config()
    project = get_env_project(config, env_name)
    backend_dir = REPO_ROOT / "backend"
    frontend_dist = REPO_ROOT / "frontend" / "dist"

    env = {**os.environ, "CI": "true"}

    print("Deploying backend Worker ...")
    proc_worker = subprocess.run(
        [wrangler_path, "deploy"],
        cwd=backend_dir,
        env=env,
        check=False,
    )
    if proc_worker.returncode != 0:
        print("[FAIL] Backend Worker deployment failed.")
        return proc_worker.returncode

    print(f"Deploying frontend Pages to project '{project}' ...")
    proc_pages = subprocess.run(
        [
            wrangler_path,
            "pages",
            "deploy",
            str(frontend_dist),
            "--project-name",
            project,
            "--commit-dirty=true",
        ],
        cwd=REPO_ROOT,
        env=env,
        check=False,
    )
    if proc_pages.returncode != 0:
        print("[FAIL] Frontend Pages deployment failed.")
        return proc_pages.returncode

    print(f"[OK] Published successfully to {env_name} ({project}).")
    return 0


def run_staging_command(env_name: str = "staging") -> int:
    """Execute complete deployment pipeline: check, codegen, build, migrate, and publish."""
    print("==================================================")
    print(f"         BYCME {env_name.upper()} PIPELINE EXECUTION         ")
    print("==================================================")

    steps = [
        ("Preflight Check", run_check_command),
        ("TypeSpec Codegen", run_codegen_command),
        ("Artifact Build", run_build_command),
        ("D1 Migrations", lambda: run_migrate_command(env_name)),
        ("Cloudflare Publish", lambda: run_publish_command(env_name)),
    ]

    for label, action in steps:
        rc = action()
        if rc != 0:
            print(f"\n[PIPELINE ABORTED] Phase '{label}' failed with exit code {rc}.")
            return rc

    print("\n==================================================")
    print("       PIPELINE COMPLETE: ALL PHASES SUCCEEDED     ")
    print("==================================================")
    return 0


def get_configured_environments() -> dict[str, dict]:
    """Retrieve mapping of configured environments from config.json."""
    config = load_config()
    envs = config.get("environments", {})
    if isinstance(envs, dict) and envs:
        return envs
    return {}


def format_custom_help() -> str:
    """Generate categorized CLI help text including configured environments."""
    lines = [
        "Usage: ./btool <command> [options]",
        "",
        "Developer workflow driver for bycme repository.",
        "",
        "Toolchain & Setup:",
        "  install            Install node, wrangler, and typespec into toolchain cache",
        "  check              Validate local toolchain dependencies and Cloudflare access",
        "  login              Authenticate interactive session with Cloudflare via wrangler",
        "",
        "Contract & Build:",
        "  codegen            Compile TypeSpec REST definitions into OpenAPI and shared models",
        "  verify             Assert generated artifacts match contracts without drift (for CI)",
        "  build              Build frontend React SPA and verify worker bundle",
        "",
        "Deployment & Operations:",
        "  migrate            Apply pending SQL migrations to D1 database (--env <name>)",
        "  publish            Deploy backend Worker and frontend Pages to Cloudflare (--env <name>)",
        "  staging            Execute complete staging pipeline (check -> codegen -> build -> migrate -> publish)",
        "  dbdrop             Drop all tables and migration state in D1 database (staging only)",
        "  dbseed             Seed D1 database from sqlsource/seeds/ (--env <name> [--dev])",
        "  passwd             Update user password in D1 database (<email> [--password <pwd>] [--dev])",
        "",
        "Options:",
        "  --env <name>       Target environment for migrate, publish, dbseed, and passwd (default: staging)",
        "  --dev              Target local D1 database emulator instead of remote Cloudflare",
        "  -h, --help         Show this help message and exit",
        "",
        "Configured Environments (from config.json):",
    ]

    envs = get_configured_environments()
    if envs:
        for name, details in envs.items():
            lines.append(f"  [{name}]")
            if isinstance(details, dict):
                for k, v in details.items():
                    key_label = k.replace("_", " ").title()
                    lines.append(f"    {key_label + ':':<18} {v}")
            else:
                lines.append(f"    {details}")
    else:
        lines.append("  (No environments configured in config.json)")

    return "\n".join(lines)


def build_parser() -> argparse.ArgumentParser:
    """Construct CLI argument parser."""
    parser = argparse.ArgumentParser(
        prog="btool",
        description="bycme developer interaction tool",
        add_help=True,
    )
    parser.format_help = format_custom_help
    parser.add_argument("--env", default="staging", help="Target environment (default: staging)")
    subparsers = parser.add_subparsers(dest="command", required=False)

    subparsers.add_parser("check", help="Check required software and Cloudflare access")
    subparsers.add_parser("install", help="Install toolchain into cache directory")
    subparsers.add_parser("login", help="Log in to Cloudflare via wrangler")
    subparsers.add_parser("codegen", help="Compile TypeSpec REST definitions")
    subparsers.add_parser("verify", help="Verify generated files match TypeSpec contract (for CI)")
    subparsers.add_parser("build", help="Build frontend and backend artifacts")

    migrate_p = subparsers.add_parser("migrate", help="Apply SQL migrations to D1 database")
    migrate_p.add_argument("--env", default="staging", help="Target environment (default: staging)")
    migrate_p.add_argument("--dev", "--local", dest="dev", action="store_true", help="Target local D1 emulator")

    publish_p = subparsers.add_parser("publish", help="Publish Worker and Pages to Cloudflare")
    publish_p.add_argument("--env", default="staging", help="Target environment (default: staging)")

    staging_p = subparsers.add_parser("staging", help="Run full pipeline (check, codegen, build, migrate, publish)")
    staging_p.add_argument("--env", default="staging", help="Target environment (default: staging)")

    dbdrop_p = subparsers.add_parser("dbdrop", help="Drop all tables and migration state in staging D1 database (staging only)")
    dbdrop_p.add_argument("--env", default="staging", help="Target environment (strictly 'staging')")
    dbdrop_p.add_argument("-y", "--yes", action="store_true", help="Confirm database drop without interactive prompt")

    dbseed_p = subparsers.add_parser("dbseed", help="Seed D1 database from sqlsource/seeds/")
    dbseed_p.add_argument("--env", default="staging", help="Target environment (default: staging)")
    dbseed_p.add_argument("--dev", "--local", dest="dev", action="store_true", help="Target local D1 emulator")

    passwd_p = subparsers.add_parser("passwd", help="Update user password in D1 database")
    passwd_p.add_argument("email", help="Target user email")
    passwd_p.add_argument("-p", "--password", default=None, help="New password (prompts securely if omitted)")
    passwd_p.add_argument("--env", default="staging", help="Target environment (default: staging)")
    passwd_p.add_argument("--dev", "--local", dest="dev", action="store_true", help="Target local D1 emulator")

    subparsers.add_parser("help", help="Show categorized help and environment details")

    return parser


def main() -> None:
    """Main CLI entrypoint."""
    prepend_bin_to_path()
    if len(sys.argv) == 1 or (len(sys.argv) == 2 and sys.argv[1] in ("-h", "--help", "help")):
        print(format_custom_help())
        sys.exit(0)

    parser = build_parser()
    args = parser.parse_args()

    if not args.command or args.command == "help":
        print(format_custom_help())
        sys.exit(0)

    target_env = getattr(args, "env", "staging")
    is_dev = getattr(args, "dev", False)

    commands = {
        "check": run_check_command,
        "install": run_install_command,
        "login": run_login_command,
        "codegen": run_codegen_command,
        "verify": run_verify_command,
        "build": run_build_command,
        "migrate": lambda: run_migrate_command(target_env, is_dev=is_dev),
        "publish": lambda: run_publish_command(target_env),
        "staging": lambda: run_staging_command(target_env),
        "dbdrop": lambda: run_dbdrop_command(target_env, auto_confirm=getattr(args, "yes", False)),
        "dbseed": lambda: run_dbseed_command(target_env, is_dev=is_dev),
        "passwd": lambda: run_passwd_command(
            getattr(args, "email", ""),
            password=getattr(args, "password", None),
            env_name=target_env,
            is_dev=is_dev,
        ),
    }

    handler = commands.get(args.command)
    if handler:
        sys.exit(handler())
    else:
        print(format_custom_help())
        sys.exit(1)


if __name__ == "__main__":
    main()
